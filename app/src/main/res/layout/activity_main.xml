<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingBottom="104dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Alex AI" android:textSize="24sp" android:textStyle="bold" android:textColor="?attr/alexText"/>
            <TextView android:id="@+id/status_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="?attr/alexText2"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <!-- HOME -->
            <LinearLayout android:id="@+id/page_home" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                    <FrameLayout android:layout_width="120dp" android:layout_height="120dp">
                        <ImageView android:id="@+id/halo" android:layout_width="84dp" android:layout_height="84dp" android:layout_gravity="center" android:src="@drawable/alex_orb" android:alpha="0" android:contentDescription="@null"/>
                        <ImageView android:id="@+id/orb" android:layout_width="84dp" android:layout_height="84dp" android:layout_gravity="center" android:src="@drawable/alex_orb" android:contentDescription="Alex"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:id="@+id/tv_hint" style="@style/Body" android:textColor="?attr/alexText2" android:textSize="13sp"/>
                        <TextView android:id="@+id/btn_start" style="@style/Btn" android:layout_height="44dp" android:text="Start Alex"/>
                    </LinearLayout>
                </LinearLayout>
                <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <LinearLayout android:id="@+id/chat_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"/>
                </ScrollView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_margin="16dp" android:paddingStart="18dp" android:paddingEnd="6dp" android:background="@drawable/glass_pill">
                    <EditText android:id="@+id/et_msg" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@null" android:hint="Message Alex…" android:imeOptions="actionSend" android:singleLine="true" android:textColor="?attr/alexText" android:textColorHint="?attr/alexText2"/>
                    <ImageView android:id="@+id/btn_mic" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_mic" android:contentDescription="Speak to Alex"/>
                    <ImageView android:id="@+id/btn_send" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_send" android:contentDescription="Send message"/>
                </LinearLayout>
            </LinearLayout>
            <!-- ACTIVITY -->
            <LinearLayout android:id="@+id/page_activity" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <TextView style="@style/Body" android:paddingHorizontal="20dp" android:text="Recent activity" android:textSize="18sp" android:textStyle="bold"/>
                <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:id="@+id/act_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"/></ScrollView>
            </LinearLayout>
            <!-- CAPABILITIES -->
            <LinearLayout android:id="@+id/page_caps" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp">
                <TextView android:id="@+id/caps_title" style="@style/Body" android:paddingHorizontal="4dp" android:textSize="18sp" android:textStyle="bold"/>
                <EditText android:id="@+id/et_search" style="@style/Field" android:hint="Search capabilities…"/>
                <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:id="@+id/cap_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="10dp"/></ScrollView>
            </LinearLayout>
            <!-- SETTINGS -->
            <ScrollView android:id="@+id/page_settings" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout style="@style/Card">
                        <TextView style="@style/Body" android:text="Gemini" android:textStyle="bold"/>
                        <TextView style="@style/Label" android:text="API key (stored encrypted with Android Keystore)"/>
                        <EditText android:id="@+id/et_key" style="@style/Field" android:inputType="textPassword" android:hint="Paste key"/>
                        <TextView style="@style/Label" android:text="Model"/>
                        <EditText android:id="@+id/et_model" style="@style/Field" android:inputType="text"/>
                        <TextView android:id="@+id/btn_savekey" style="@style/Btn" android:text="Save"/>
                        <TextView android:id="@+id/btn_delkey" style="@style/BtnGhost" android:text="Delete saved key"/>
                        <TextView style="@style/Label" android:text="A key inside any app can be extracted from a compromised device. For a public release use a backend proxy instead of a personal key."/>
                    </LinearLayout>
                    <LinearLayout style="@style/Card">
                        <TextView style="@style/Body" android:text="Voice" android:textStyle="bold"/>
                        <Switch android:id="@+id/sw_speak" style="@style/Body" android:text="Spoken replies" android:layout_marginTop="8dp"/>
                        <TextView style="@style/Label" android:text="Speech rate"/>
                        <SeekBar android:id="@+id/sb_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="150"/>
                        <TextView style="@style/Label" android:text="Voice pitch (higher = younger)"/>
                        <SeekBar android:id="@+id/sb_pitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="150"/>
                        <TextView android:id="@+id/btn_lang" style="@style/BtnGhost"/>
                        <Switch android:id="@+id/sw_wake" style="@style/Body" android:text="“Hey Alex” wake phrase" android:layout_marginTop="14dp"/>
                        <TextView style="@style/Label" android:text="The wake phrase uses Android’s speech recognizer, which may send audio to Google while active. A visible notification and orb show whenever the microphone is on. A fully offline detector is planned."/>
                    </LinearLayout>
                    <LinearLayout style="@style/Card">
                        <TextView style="@style/Body" android:text="Appearance &amp; privacy" android:textStyle="bold"/>
                        <TextView android:id="@+id/btn_theme" style="@style/BtnGhost"/>
                        <Switch android:id="@+id/sw_hist" style="@style/Body" android:text="Keep conversation history" android:layout_marginTop="14dp"/>
                        <Switch android:id="@+id/sw_screen" style="@style/Body" android:text="Let Alex read on-screen text to choose what to tap" android:layout_marginTop="10dp"/>
                        <TextView android:id="@+id/btn_clearhist" style="@style/BtnGhost" android:text="Clear history now"/>
                        <TextView android:id="@+id/btn_stopsvc" style="@style/BtnGhost" android:text="Stop background listening"/>
                    </LinearLayout>
                    <LinearLayout style="@style/Card">
                        <TextView style="@style/Body" android:text="Permissions" android:textStyle="bold"/>
                        <TextView android:id="@+id/st_mic" style="@style/Row"/>
                        <TextView android:id="@+id/st_notif" style="@style/Row"/>
                        <TextView android:id="@+id/st_overlay" style="@style/Row"/>
                        <TextView android:id="@+id/st_acc" style="@style/Row"/>
                        <TextView android:id="@+id/st_contacts" style="@style/Row"/>
                        <TextView style="@style/Label" android:text="Microphone: voice. Notifications: listening indicator. Display over apps: orb and confirmation prompts. Accessibility: back, scroll, tap, type. Contacts (optional): call or message by name."/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_about" style="@style/Label" android:layout_gravity="center_horizontal"/>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp" android:orientation="horizontal" android:padding="6dp" android:background="@drawable/glass_pill">
        <LinearLayout android:id="@+id/tab0" style="@style/TabItem"><ImageView style="@style/TabIcon" android:src="@drawable/ic_home" android:contentDescription="@null"/><TextView style="@style/TabText" android:text="Home"/></LinearLayout>
        <LinearLayout android:id="@+id/tab1" style="@style/TabItem"><ImageView style="@style/TabIcon" android:src="@drawable/ic_history" android:contentDescription="@null"/><TextView style="@style/TabText" android:text="Activity"/></LinearLayout>
        <LinearLayout android:id="@+id/tab2" style="@style/TabItem"><ImageView style="@style/TabIcon" android:src="@drawable/ic_apps" android:contentDescription="@null"/><TextView style="@style/TabText" android:text="Skills"/></LinearLayout>
        <LinearLayout android:id="@+id/tab3" style="@style/TabItem"><ImageView style="@style/TabIcon" android:src="@drawable/ic_tune" android:contentDescription="@null"/><TextView style="@style/TabText" android:text="Settings"/></LinearLayout>
    </LinearLayout>
</FrameLayout>
