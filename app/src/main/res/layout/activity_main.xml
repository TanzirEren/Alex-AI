<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="120dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/page_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alex" android:textSize="36sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:layout_marginTop="16dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your AI phone assistant" android:textSize="14sp" android:textColor="#B3FFFFFF"/>
                <FrameLayout android:layout_width="250dp" android:layout_height="250dp" android:layout_marginTop="20dp">
                    <ImageView android:id="@+id/halo" android:layout_width="190dp" android:layout_height="190dp" android:layout_gravity="center" android:src="@drawable/alex_orb" android:alpha="0"/>
                    <ImageView android:id="@+id/orb" android:layout_width="190dp" android:layout_height="190dp" android:layout_gravity="center" android:src="@drawable/alex_orb"/>
                </FrameLayout>
                <TextView android:id="@+id/status_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Say “Hey Alex” to start" android:textSize="16sp" android:textColor="#FFFFFF" android:layout_marginBottom="20dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/glass_card">
                    <TextView android:id="@+id/st_perm" style="@style/Row"/>
                    <TextView android:id="@+id/st_overlay" style="@style/Row"/>
                    <TextView android:id="@+id/st_acc" style="@style/Row"/>
                    <TextView android:id="@+id/st_key" style="@style/Row"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_start" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="22dp" android:gravity="center" android:text="Start Alex" android:textSize="17sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:background="@drawable/btn_primary"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/page_features" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="What Alex can do" android:textSize="26sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:layout_marginBottom="16dp" android:layout_marginTop="16dp"/>
                <TextView android:id="@+id/features_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:textSize="15sp" android:lineSpacingExtra="4dp" android:textColor="#E6FFFFFF" android:background="@drawable/glass_card"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/page_settings" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textSize="26sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:layout_marginBottom="16dp" android:layout_marginTop="16dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/glass_card">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gemini API key" android:textColor="#B3FFFFFF" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_key" android:layout_width="match_parent" android:layout_height="52dp" android:inputType="textPassword" android:singleLine="true" android:padding="14dp" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:layout_marginTop="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model" android:textColor="#B3FFFFFF" android:textSize="13sp" android:layout_marginTop="14dp"/>
                    <EditText android:id="@+id/et_model" android:layout_width="match_parent" android:layout_height="52dp" android:inputType="text" android:singleLine="true" android:padding="14dp" android:textColor="#FFFFFF" android:background="@drawable/input_bg" android:layout_marginTop="6dp"/>
                    <Switch android:id="@+id/sw_wake" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Always listen for “Hey Alex”" android:textColor="#FFFFFF" android:layout_marginTop="18dp"/>
                    <TextView android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Save" android:textColor="#FFFFFF" android:textSize="16sp" android:background="@drawable/btn_primary" android:layout_marginTop="20dp"/>
                    <TextView android:id="@+id/btn_acc" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Open Accessibility settings" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/glass_pill" android:layout_marginTop="12dp"/>
                    <TextView android:id="@+id/btn_perm" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Grant permissions" android:textColor="#FFFFFF" android:textSize="15sp" android:background="@drawable/glass_pill" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="28dp" android:orientation="horizontal" android:padding="8dp" android:background="@drawable/glass_pill">
        <ImageView android:id="@+id/tab0" style="@style/Tab" android:src="@drawable/ic_home"/>
        <ImageView android:id="@+id/tab1" style="@style/Tab" android:src="@drawable/ic_apps"/>
        <ImageView android:id="@+id/tab2" style="@style/Tab" android:src="@drawable/ic_tune"/>
    </LinearLayout>
</FrameLayout>
